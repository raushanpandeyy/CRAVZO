{
  "family": "dodago-backend",
  "executionRoleArn": "arn:aws:iam::968138089427:role/dodago-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "dodago-backend",
      "image": "968138089427.dkr.ecr.ap-south-1.amazonaws.com/dodago-backend:latest-20260901",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "dodago-backend-5000",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "CLIENT_URL", "value": "https://www.dodago.shop" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "ORDER_QUEUE_ENABLED", "value": "true" },
        { "name": "EMAIL_PROVIDER", "value": "resend" },
        { "name": "PORT", "value": "5000" },
        { "name": "EMAIL_FROM", "value": "otp@dodago.shop" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:DATABASE_URL::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:JWT_SECRET::" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:REDIS_URL::" },
        { "name": "RESEND_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:RESEND_API_KEY::" },
        { "name": "CLOUDINARY_CLOUD_NAME", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:CLOUDINARY_CLOUD_NAME::" },
        { "name": "CLOUDINARY_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:CLOUDINARY_API_KEY::" },
        { "name": "CLOUDINARY_API_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:CLOUDINARY_API_SECRET::" },
        { "name": "CLOUDINARY_FOLDER", "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:CLOUDINARY_FOLDER::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dodago-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
