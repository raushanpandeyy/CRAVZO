generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String       @id @default(cuid())
  name                  String
  email                 String       @unique
  phone                 String?      @unique
  passwordHash          String
  role                  UserRole
  isOnline              Boolean      @default(false)
  latitude              Float?
  longitude             Float?
  status                UserStatus   @default(PENDING)
  avatarUrl             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  vendorOnboarding      Json?
  riderOnboarding       Json?
  bankDetails           Json?
  vehicleDetails        Json?
  paymentMethods        Json?
  onboardingSubmittedAt DateTime?
  addresses             Address[]
  favorites             Favorite[]
  customerOrders        Order[]      @relation("CustomerOrders")
  riderOrders           Order[]      @relation("AssignedRiderOrders")
  restaurants           Restaurant[] @relation("VendorRestaurants")
  reviews               Review[]
  supportChatRoom       ChatRoom?    @relation("SupportChatOwner")
  chatMessages          ChatMessage[]
  fcmTokens             FcmToken[]

  @@index([status])
  @@index([role, status, createdAt])
  @@index([role, status, isOnline])
  @@index([role, status, createdAt, id])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([userId, isDefault, updatedAt])
  @@index([userId, updatedAt])
}

model Restaurant {
  id           String           @id @default(cuid())
  vendorId     String
  name         String
  slug         String           @unique
  description  String?
  cuisine      String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  imageUrl     String?
  status       RestaurantStatus @default(DRAFT)
  isOpen       Boolean          @default(false)
  openingTime  String?
  closingTime  String?
  openDays     Json?
  bankDetails  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  favorites    Favorite[]
  menuItems    MenuItem[]
  orders       Order[]
  vendor       User             @relation("VendorRestaurants", fields: [vendorId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@index([vendorId, createdAt])
  @@index([status, isOpen, createdAt])
  @@index([status, isOpen, city])
  @@index([city])
  @@index([city, status, isOpen])
  @@index([latitude, longitude])
}

model MenuItem {
  id           String         @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  category     String
  imageUrl     String?
  price        Decimal        @db.Decimal(10, 2)
  sizes        Json?
  isVeg        Boolean        @default(false)
  status       MenuItemStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, status, category])
  @@index([restaurantId, status, category, price])
}

model Order {
  id               String        @id @default(cuid())
  customerId       String
  restaurantId     String
  addressId        String?
  riderId          String?
  rejectedRiderIds String[]      @default([])
  gatewayProvider  String?
  gatewayOrderId   String?       @unique
  gatewayPaymentId String?       @unique
  gatewaySignature String?
  status           OrderStatus   @default(PENDING)
  paymentMethod    PaymentMethod @default(COD)
  paymentStatus    PaymentStatus @default(PENDING)
  subtotal         Decimal       @db.Decimal(10, 2)
  deliveryFee      Decimal       @db.Decimal(10, 2) @default(0)
  deliveryFeeBase  Decimal       @db.Decimal(10, 2) @default(0)
  deliveryTax      Decimal       @db.Decimal(10, 2) @default(0)
  packagingFee     Decimal       @db.Decimal(10, 2) @default(0)
  packagingFeeBase Decimal       @db.Decimal(10, 2) @default(0)
  packagingTax     Decimal       @db.Decimal(10, 2) @default(0)
  platformFee      Decimal       @db.Decimal(10, 2) @default(0)
  platformFeeBase  Decimal       @db.Decimal(10, 2) @default(0)
  platformTax      Decimal       @db.Decimal(10, 2) @default(0)
  gatewayFee       Decimal       @db.Decimal(10, 2) @default(0)
  codCharge        Decimal       @db.Decimal(10, 2) @default(0)
  discount         Decimal       @db.Decimal(10, 2) @default(0)
  couponCode       String?
  totalTax         Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount      Decimal       @db.Decimal(10, 2) @default(0)
  notes            String?
  deliveryDistance Decimal?      @db.Decimal(5, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  address          Address?      @relation(fields: [addressId], references: [id])
  customer         User          @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurant       Restaurant    @relation(fields: [restaurantId], references: [id])
  rider            User?         @relation("AssignedRiderOrders", fields: [riderId], references: [id])
  items            OrderItem[]
  chatRooms        ChatRoom[]

  @@index([customerId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([riderId, status, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([customerId, status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  size       String?
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
}

model Review {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
}

model ChatRoom {
  id            String        @id @default(cuid())
  type          ChatRoomType
  orderId       String?
  supportUserId String?       @unique
  status        ChatRoomStatus @default(ACTIVE)
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supportUser   User?         @relation("SupportChatOwner", fields: [supportUserId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@unique([type, orderId])
  @@index([type, lastMessageAt])
  @@index([orderId, type])
  @@index([supportUserId, lastMessageAt])
}

model ChatMessage {
  id        String          @id @default(cuid())
  roomId    String
  senderId  String
  text      String?
  imageUrl  String?
  kind      ChatMessageKind @default(TEXT)
  createdAt DateTime        @default(now())
  room      ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt, id])
  @@index([senderId, createdAt])
}

model FcmToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceId   String?
  platform   String   @default("WEB")
  userAgent  String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, updatedAt])
  @@index([token])
}

model OtpVerification {
  id                String     @id
  email             String
  purpose           OtpPurpose
  codeHash          String
  pendingSignupData Json?
  expiresAt         DateTime
  verifiedAt        DateTime?
  usedAt            DateTime?
  sentCount         Int        @default(1)
  attemptCount      Int        @default(0)
  lastSentAt        DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime

  @@index([email, purpose, createdAt])
}

enum UserRole {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum RestaurantStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
}

enum MenuItemStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  COD
  CARD
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OtpPurpose {
  CUSTOMER_SIGNUP
  VENDOR_ONBOARDING
  RIDER_ONBOARDING
  PASSWORD_RESET
}

enum ChatRoomType {
  SUPPORT
  ORDER_RIDER
}

enum ChatRoomStatus {
  ACTIVE
  CLOSED
}

enum ChatMessageKind {
  TEXT
  IMAGE
  MIXED
}

model FeaturedRestaurant {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  imageUrl     String?
  position     Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([isActive, position])
  @@index([restaurantId])
}

model Ad {
  id        String   @id @default(cuid())
  imageUrl  String
  link      String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

model DishPromotion {
  id            String   @id @default(cuid())
  referenceType String    // "dish" | "free_delivery"
  referenceId   String    // menuItem.id for dish, restaurant.id for free_delivery
  position      Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, position])
}
