EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Maps Android API key (required for react-native-maps MapView on Android).
# Create at https://console.cloud.google.com/ -> APIs & Services -> Credentials -> API key,
# enable "Maps SDK for Android", restrict the key to your Android app's SHA-1 + package name.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_android_api_key

# MapLibre style URL for the lightweight live tracking map (LightweightTrackingMap.js).
# Free no-key options that cover India:
#   OpenFreeMap liberty: https://tiles.openfreemap.org/styles/liberty
#   OpenFreeMap bright:   https://tiles.openfreemap.org/styles/bright
# For higher rate limits use MapTiler: https://api.maptiler.com/maps/basic/style.json?key=YOUR_KEY
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
