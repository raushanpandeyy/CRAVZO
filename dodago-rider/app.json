{
  "expo": {
    "name": "Dodago Rider",
    "slug": "dodago-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "shop.dodago.rider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dodago Rider needs your location to assign orders and share live delivery updates.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Dodago Rider needs location while you deliver active orders."
      }
    },
    "android": {
      "package": "shop.dodago.rider",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#059669",
          "sounds": ["./assets/alert.wav"],
          "androidMode": "default",
          "androidCollapsedTitle": "New Order"
        }
      ],
      "expo-location"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "https://api.dodago.shop",
      "eas": {
        "projectId": "dc842aa9-48b2-4ecf-9c9d-17b0c927bc9c"
      }
    }
  }
}
