# Public API domain. DNS A record should point this domain to your EC2/Lightsail public IP.
API_DOMAIN=api.dodago.shop

# Backend runtime
NODE_ENV=production
PORT=5000
CLIENT_URL=https://www.dodago.shop
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Local Postgres inside Docker. If you change POSTGRES_PASSWORD, also update DATABASE_URL.
POSTGRES_DB=dodago
POSTGRES_USER=dodago
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://dodago:change-this-db-password@postgres:5432/dodago?schema=public
REPLICA_DATABASE_URL=
PGBOUNCER_URL=

# Local Valkey/Redis inside Docker
REDIS_URL=redis://valkey:6379
ORDER_QUEUE_ENABLED=true

# Google Maps server key. Restrict this key by server IP in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Rain charge defaults. Admin setting can still control this in the app where available.
RAIN_CHARGE_ENABLED=false
RAIN_CHARGE_AMOUNT=25

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PERCENT=0.02
COD_CHARGE=5

# Email / OTP fallback
EMAIL_PROVIDER=console
EMAIL_FROM=otp@dodago.shop
RESEND_API_KEY=
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dodago

# Firebase Admin for push notifications. Prefer base64 service-account JSON in production.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Pricing defaults
DELIVERY_BASE_FEE=33
DELIVERY_BASE_KM=5
DELIVERY_PER_KM_RATE=10
GST_RATE=0.18
FOOD_GST_RATE=0.05
DELIVERY_GST_RATE=0.18
PLATFORM_FEE=0
PACKAGING_PERCENT=0.01