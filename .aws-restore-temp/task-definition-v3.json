{
  "family": "dodago-railway-restore",
  "executionRoleArn": "arn:aws:iam::968138089427:role/dodago-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "dodago-backend",
      "image": "968138089427.dkr.ecr.ap-south-1.amazonaws.com/dodago-backend:railway-restore-20260705-v3",
      "essential": true,
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:968138089427:secret:dodago/backend-bYMSqH:DATABASE_URL::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dodago-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "restore"
        }
      }
    }
  ]
}
